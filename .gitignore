# generated data — all reproducible via `make corpus` / `make kpi` / `make report`,
# so it is deliberately not committed. Keeping 400+ binary captures in git would
# bloat the repo and they can be regenerated byte-identically from their seeds.
data/db/
data/artifacts/
data/pcaps/
data/logs/
data/baselines/
data/report/
data/corpus_manifest.json
!data/**/.gitkeep

# macOS
.DS_Store

# Personal study and interview-preparation material.
