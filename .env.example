# Copy to .env and fill in. .env is gitignored.

# ---- LLM provider for the triage agent ----
# Groq is free and fast: https://console.groq.com/keys
# With no key set, the triage agent falls back to the deterministic Mock provider,
# so every part of the project still runs — you just get rule-based verdicts
# instead of model-generated ones.
GROQ_API_KEY=

# Optional: force a provider. Default is groq when a key is present, else mock.
# AIRFRAME_LLM_PROVIDER=groq

# Optional alternative provider.
# ANTHROPIC_API_KEY=

# ---- MCP server ----
# Set to 1 to let an MCP client actually RUN tests. Off by default: read-only.
# Even when enabled, only the simulator backend can be driven — never real hardware.
AIRFRAME_MCP_ALLOW_RUN=0

# ---- overrides (all optional) ----
# AIRFRAME_DB=data/db/airframe.db
# AIRFRAME_DUT=sim
# AIRFRAME_SEED=42
# AIRFRAME_SIM_BINARY=sim/build/airframe-sim
